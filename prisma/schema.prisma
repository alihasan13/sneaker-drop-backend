

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USERS  (demo only — no auth)
// ─────────────────────────────────────────
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  reservations Reservation[]
  purchases    Purchase[]

  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────
// DROPS
// ─────────────────────────────────────────
model Drop {
  id          String     @id @default(cuid())
  name        String
  brand       String
  colorway    String
  description String?
  imageUrl    String?
  price       Decimal    @db.Decimal(10, 2)
  startsAt    DateTime
  endsAt      DateTime?
  isActive    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  inventory    Inventory?
  purchases    Purchase[]
  reservations Reservation[]

  // Composite index: fetching active drops sorted by start time
  @@index([isActive, startsAt])
  @@map("drops")
}

// ─────────────────────────────────────────
// INVENTORY  (separate table for row-level locking)
// ─────────────────────────────────────────
// availableStock = totalStock - reservedStock - soldStock
// This is NEVER stored — always derived. Prevents sync bugs.
// A DB-level CHECK constraint enforces the invariant.
model Inventory {
  id            String   @id @default(cuid())
  dropId        String   @unique
  totalStock    Int
  reservedStock Int      @default(0)
  soldStock     Int      @default(0)
  updatedAt     DateTime @updatedAt

  drop Drop @relation(fields: [dropId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// ─────────────────────────────────────────
// RESERVATIONS
// ─────────────────────────────────────────
model Reservation {
  id        String            @id @default(cuid())
  userId    String
  dropId    String
  quantity  Int               @default(1)
  status    ReservationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  drop     Drop      @relation(fields: [dropId], references: [id])
  purchase Purchase?

  // One PENDING reservation per user per drop — enforced at DB level
  // Note: partial unique index via migration SQL (WHERE status = 'PENDING')
  @@index([dropId, status])
  @@index([status, expiresAt]) // expiry cron: fast scan of PENDING past expiresAt
  @@index([userId, dropId])
  @@map("reservations")
}

// ─────────────────────────────────────────
// PURCHASES
// ─────────────────────────────────────────
model Purchase {
  id            String   @id @default(cuid())
  userId        String
  dropId        String
  reservationId String   @unique // one purchase per reservation — DB-enforced idempotency
  quantity      Int
  totalPrice    Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  drop        Drop        @relation(fields: [dropId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  // Latest purchasers per drop: O(log n) with this index
  @@index([dropId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("purchases")
}

enum ReservationStatus {
  PENDING   // held, not yet purchased
  COMPLETED // purchase confirmed — stock permanently sold
  EXPIRED   // 60s elapsed — stock returned to pool
  CANCELLED // user explicitly cancelled
}
